{
	"name": "devbench",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright test",
		"preview:static": "node scripts/serve-static.mjs",
		"capture": "node scripts/capture.mjs",
		"capture:v12": "node scripts/capture-v12.mjs"
	},
	"devDependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@eslint/js": "^10.0.1",
		"@fontsource/geist": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/papaparse": "^5.5.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@cfworker/json-schema": "4.1.1",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"croner": "^10.0.1",
		"cronstrue": "^3.38.0",
		"diff": "^9.0.0",
		"konva": "10.9.0",
		"papaparse": "^5.7.0",
		"roughjs": "4.6.6",
		"sql-formatter": "^15.9.0",
		"svelte-konva": "1.0.1",
		"yaml": "^2.9.1"
	}
}
